{
  "manifest_version": 3,
  "name": "Nonsense Blocker",
  "version": "1",
  "description": "Blocks distracting websites locally.",
  "permissions": [
    "declarativeNetRequest",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://*.instagram.com/*",
    "*://*.linkedin.com/*",
    "*://*.tradingview.com/*",
    "*://*.pinterest.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}