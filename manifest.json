{
  "manifest_version": 3,
  "name": "Nonsense Blocker",
  "version": "1",
  "description": "Blocks distracting websites locally.",
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}